          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/aiqt_hooks.py",
              "gensrc_guard"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/aiqt_hooks.py",
              "git_discard"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
