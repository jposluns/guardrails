{
  "description": "AIQT Guardrails mechanical-enforcement hooks, generated from .aiqt/core/hooks/manifest.toml by tools/gen_hooks.py; do not hand-edit.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/aiqt_hooks.py",
              "absolute_paths"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/aiqt_hooks.py",
              "bash_absolute_paths"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/aiqt_hooks.py",
              "branch_root"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/aiqt_hooks.py",
              "commit_identity"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/aiqt_hooks.py",
              "commit_msg_subst"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/aiqt_hooks.py",
              "diff_source_pretool"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "-S",
              "-B",
              "-c",
              "import sys\np = sys.argv[1] if len(sys.argv) > 1 else ''\nr = 1\nm = 'was given no script path'\ntry:\n    if p:\n        import runpy\n        sys.argv = [p]\n        runpy.run_path(p, run_name='__main__')\n        r = 0\nexcept SystemExit as e:\n    r = 0 if e.code is None or e.code == 0 else 1\n    m = 'exited %r' % (e.code,)\nexcept BaseException as e:\n    m = 'did not run: %s: %s' % (type(e).__name__, e)\nif r:\n    try:\n        sys.stderr.write('aiqt hook launcher: %s %s; reported as exit 1, never 2\\n' % (p, m))\n    except BaseException:\n        pass\nsys.exit(r)\n",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/future-stamp-write.py"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/aiqt_hooks.py",
