#!/bin/sh
# OPF pre-commit floor: the staged-snapshot hook (enforcement pack, spec 1.3.0 (draft) 14.1: the pack MUST
# provide staged-snapshot pre-commit checks with the per-clone installation residual disclosed).
#
#   sh opf/enforcement/precommit/install.sh     once per clone: git then runs this hook (through the stub
#                                               the installer writes) at each git commit, but not for
#                                               the operations listed under Residuals
#   sh opf/enforcement/precommit/pre-commit     by hand, from the repository top level
#   sh opf/enforcement/precommit/pre-commit pre-merge-commit
#                                               as the pre-merge-commit hook (the installer's second
#                                               stub): see Merge commits below
#
# It checks the snapshot the commit would record, never the working tree:
#   1. git write-tree records the staged index as a tree. Git points GIT_INDEX_FILE at the index it is
#      about to commit, so `git commit -a` and `git commit PATH` are checked against that index.
#   2. A throwaway repository in a temporary directory borrows this repository's objects
#      (objects/info/alternates), points HEAD at the current commit (none on an unborn branch), carries
#      each remote's push URL and, while a merge is being concluded, the commit ids MERGE_HEAD names (see
#      Merge commits below), and checks the staged tree out as its index and working tree.
#   3. The CI floor's two checks run over that snapshot, in order, stopping at the first failure:
#      opf doctor --require-store, then opf render --check (see ../ci/opf-ci.sh).
# Exit status is 0/1/2 only (0 clean, 1 finding, 2 cannot-evaluate), normalized as in opf-ci.sh; git
# refuses the commit on any status but 0. The temporary directory is removed on exit, and a removal that
# fails exits 2 naming the directory left behind. The only write to this repository is the tree objects
# git write-tree stores, which the commit itself would store. Every failure to build the snapshot,
# including a failure to list the environment whose GIT_ variables it drops, exits 2 before any check.
#
# Before its first git call it drops every inherited GIT_ variable except the ones that name the
# repository, its objects, the index being committed and the configuration the commit reads (the case
# list below), so no GIT_TRACE*, GIT_TRACE2* or other inherited destination makes git write a file; the
# snapshot then drops those too. Its own directory is resolved with a status-checked dirname, so a
# missing dirname exits 2 rather than resolving to the launching directory.
#
# Requires git 2.32 or later (GIT_CONFIG_GLOBAL; --path-format=absolute needs 2.31); an older git exits 2.
#
# Environment overrides:
#   OPF_PYTHON  the interpreter (default: python3); always launched isolated (-I -B)
#   OPF_TOOL    the path to opf.py (default: ../../tools/opf.py beside this file, the pack layout)
#   TMPDIR      where the snapshot is built (default: /tmp)
#
# The installer writes a stub into the clone's untracked hooks directory (the common git directory's,
# for linked worktrees) and never sets core.hooksPath, so no tracked file can become a hook. The stub
# exits 2 when this file is missing or unreadable in the working tree being committed (a branch that
# predates the pack, say), so a missing hook is never silent.
#
# Merge commits: git commit runs the pre-commit hook, but a merge that git merge (or git pull) concludes
# without stopping for a conflict runs the pre-merge-commit hook instead, and githooks(5) gives that hook
# no documented way to name the merged commit. The installer's pre-merge-commit stub runs this file with
# the operand pre-merge-commit, which runs no check and exits 2 with a message telling the operator to
# conclude the merge with git commit; a non-zero exit makes git merge stop before it creates the commit.
# The self-test confirms, on the git it runs, that the stop leaves the merge result in the index and
# MERGE_HEAD naming the merged commit, so git commit concludes the merge through this hook. A git that
# leaves no MERGE_HEAD there has stopped the merge altogether, so the message also tells the operator, in
# that case, to rerun it as git merge --no-commit and conclude it with git commit.
# Concluding a merge (MERGE_HEAD present), the commit records the staged result with HEAD and each commit
# MERGE_HEAD names as its parents, and comparing with HEAD alone would let a merge such as
# git merge -s ours drop every record the merged branch added. So this hook carries every MERGE_HEAD
# commit id into the snapshot as its MERGE_HEAD, and the doctor then compares the staged result with
# EVERY parent: each record a parent's type indexes hold must survive (a worklog entry is not an indexed
# record, so a dropped entry is caught only as a lowered counter, and tied counters do not expose it),
# no counter may fall below its value in any parent, and a record any parent holds at an unqualified
# terminal state must keep that state in the result, refusing on any dropped record, lowered counter or
# terminal-status resurrection, while a merge commit's non-terminal status changes are not graded (see
# Residuals). A MERGE_HEAD that cannot be read, or holds anything but commit ids of this
# repository, exits 2 before any check, never an unchecked merge.
#
# Residuals this hook does not close (spec 14.1):
#   - Per-clone installation: the stub is local to the clone. It is not cloned or pushed, so a clone that
#     never ran install.sh runs no hook.
#   - Bypass: git commit --no-verify skips the hook, and git merge --no-verify (git pull --no-verify)
#     skips the pre-merge-commit stub, so a merge commits without stopping and unchecked; the same user
#     can remove either stub or edit this file. A core.hooksPath set later, in any configuration scope,
#     makes git stop running the stubs, silently.
#   - Operations git commits without running any pre-commit hook: cherry-pick, revert, rebase (and
#     pull --rebase), am, and a fast-forward git merge or git pull, which moves HEAD to commits recorded
#     elsewhere with no hook run here. Each records or brings in commits this hook never checks. A merge
#     that git merge or git pull would commit without stopping is stopped by the pre-merge-commit stub
#     (above), and a merge concluded with git commit is checked.
#   - Scripted merges: that stop makes a scripted (non-interactive) git merge or git pull in merge mode
#     exit 1 and leave MERGE_HEAD and the staged merge result behind, so a later git pull exits 128
#     ("You have not concluded your merge") until the merge is concluded with git commit or abandoned
#     with git merge --abort. A pipeline that assumes git pull always exits 0 breaks at the first
#     non-fast-forward merge.
#   - Merge commits: concluding one (MERGE_HEAD present), the staged result is compared with every
#     parent for dropped records, lowered counters and terminal-status resurrection (see Merge commits
#     above), but a merge commit's non-terminal status changes are not graded: transition legality is
#     skipped for a merge commit, so a non-terminal status a parent holds may change in the result
#     unchecked (each branch's own transitions were graded when that branch committed them through this
#     hook; one committed past it is not re-graded here), and a dropped worklog entry is caught only as
#     a lowered counter (tied counters do not expose it).
#   - The hook runs checked-out code: the stub runs the working-tree copy of this file, and this file
#     runs the working-tree opf.py (OPF_TOOL), not the staged ones. Checking out a branch, merge or pull
#     request that changes them runs the changed code, with the user's privileges, at the next git
#     commit.
#   - What CI does and does not catch: ../ci/opf-ci.sh runs the same two checks over the revision CI
#     checks out, so a store or declared view that fails them in that revision alone is caught, whether
#     or not its commits bypassed this hook. The history checks (C-HISTORY-RESURRECTION,
#     C-HISTORY-APPEND-ONLY, C-HISTORY-COUNTERS) compare the store with its prior committed snapshot,
#     which in CI is the checked-out commit itself, so CI does not catch a history violation committed
#     past this hook (the CI receipt-identity comparison is a later release, U25). For those checks this
#     hook is the pack's only check.
#   - The snapshot checkout reads no global, system or local configuration of this repository, so a
#     clean or smudge filter that configuration defines is not applied to the snapshot.
#   - Only this repository's staged tree is snapshotted; a store that lives in another repository is not.
set -u
# Run as pre-merge-commit, it runs no check (see Merge commits above) and refuses the merge commit, so
# that git merge stops before creating it and git commit concludes the merge through this hook.
if [ "$#" -eq 1 ] && [ "$1" = pre-merge-commit ]; then
    echo "opf-pre-commit: refused as pre-merge-commit: git merge records a merge commit without the pre-commit check, so this merge is not committed. Conclude it with git commit, which runs the check. If git rev-parse -q --verify MERGE_HEAD prints nothing (a git that leaves no merge in progress here), rerun the merge as git merge --no-commit and conclude it with git commit." >&2
    exit 2
fi
if [ "$#" -gt 0 ]; then
    echo "opf-pre-commit: usage: sh pre-commit [pre-merge-commit] (no other operand; run it from the repository top level)" >&2
    exit 2
fi
fail() {
    printf '%s\n' "opf-pre-commit: cannot evaluate: $1" >&2
    exit 2
}
# The inherited GIT_ variables. The listing and its parse are two checked steps, so a failure of either
# (a missing env or sed, say) stops here. Only the variables that name the repository, its objects, the
# index being committed and the configuration the commit reads are kept, so these reads see what the
# commit records; every other one (GIT_TRACE*, GIT_TRACE2* and any not named here) is dropped before
# the first git call. The snapshot below drops the kept ones too.
envlist=$(env) || fail "could not list the environment"
git_vars=$(printf '%s\n' "$envlist" | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p') || \
    fail "could not read the GIT_ variable names from the environment"
for var in $git_vars; do
    case "$var" in
        GIT_DIR|GIT_WORK_TREE|GIT_COMMON_DIR|GIT_INDEX_FILE|GIT_OBJECT_DIRECTORY|\
        GIT_ALTERNATE_OBJECT_DIRECTORIES|GIT_NAMESPACE|GIT_CEILING_DIRECTORIES|\
        GIT_DISCOVERY_ACROSS_FILESYSTEM|GIT_NO_REPLACE_OBJECTS|GIT_REPLACE_REF_BASE|\
        GIT_CONFIG_GLOBAL|GIT_CONFIG_SYSTEM|GIT_CONFIG_NOSYSTEM|GIT_CONFIG_PARAMETERS|GIT_CONFIG_COUNT|\
        GIT_CONFIG_KEY_*|GIT_CONFIG_VALUE_*) ;;
        *) unset "$var" || fail "could not drop $var from the environment" ;;
    esac
done
# The directory of this file, resolved in two checked steps: a dirname that fails (missing, say) stops
# here, rather than leaving an empty name that `cd` would read as the launching directory.
dir=$(dirname -- "$0") || fail "could not resolve the directory of $0 (dirname failed)"
[ -n "$dir" ] || fail "could not resolve the directory of $0"
# CDPATH is cleared for this one command, as in opf-ci.sh: a CDPATH match makes `cd` print a line.
here=$(CDPATH= cd -- "$dir" && pwd) || fail "could not enter $dir"
opf_python=${OPF_PYTHON:-python3}
opf_tool=${OPF_TOOL:-$here/../../tools/opf.py}
gv=$(git --version) || fail "could not read the git version"
gv=${gv#git version }
gmajor=${gv%%.*}
gminor=${gv#*.}
gminor=${gminor%%.*}
case "$gmajor$gminor" in
    ''|*[!0-9]*) fail "could not parse the git version $gv" ;;
esac
[ "$gmajor" -gt 2 ] || { [ "$gmajor" -eq 2 ] && [ "$gminor" -ge 32 ]; } || \
    fail "git $gv is older than 2.32, the floor this hook needs"
# Run one check step and normalize its status: the step's own 0/1/2 is returned unchanged, and any other
# status (a launch failure such as 126 or 127, or a signal death) becomes 2 (cannot-evaluate).
run_step() {
    "$opf_python" -I -B "$opf_tool" "$@"
    rc=$?
    case "$rc" in
        0|1|2) return "$rc" ;;
    esac
    return 2
}

# These reads use git's own hook environment, so they see the repository and index being committed.
tree=$(git write-tree) || fail "git write-tree could not record the staged index as a tree"
if head=$(git rev-parse -q --verify 'HEAD^{commit}'); then
    :
else
    # Only an unborn branch may have no HEAD commit; anything else is unreadable, never an empty history.
    ref=$(git symbolic-ref -q HEAD) || fail "HEAD names no commit and is not an unborn branch"
    found=$(git for-each-ref "$ref") || fail "git for-each-ref could not read $ref"
    [ -z "$found" ] || fail "HEAD names $ref, which does not resolve to a commit"
    head=
fi
objects=$(git rev-parse --path-format=absolute --git-path objects) || fail "could not locate the object store"
remotes=$(git remote) || fail "git remote could not list the remotes"
# Concluding a merge, MERGE_HEAD names the merged commit(s), one lowercase-hex id per line (several for an
# octopus merge). Its ids are validated and carried into the snapshot as its MERGE_HEAD, so the doctor
# compares the staged result with every parent (see Merge commits above). Reading MERGE_HEAD as a file
# (git rev-parse MERGE_HEAD resolves only its first line) keeps every merged commit; one that cannot be
# read or does not hold commit ids of this repository exits 2 before any check.
mh_lines=
mh_path=$(git rev-parse --path-format=absolute --git-path MERGE_HEAD) || fail "could not locate MERGE_HEAD"
if [ -e "$mh_path" ] || [ -L "$mh_path" ]; then
    [ -n "$head" ] || fail "MERGE_HEAD is present but HEAD names no commit"
    mh_lines=$(cat -- "$mh_path") || fail "could not read $mh_path"
    [ -n "$mh_lines" ] || fail "$mh_path names no commit"
    for mh in $mh_lines; do
        case "$mh" in
            *[!0-9a-f]*|'') fail "$mh_path holds $mh, which is not a commit id" ;;
        esac
        git rev-parse -q --verify "$mh^{commit}" > /dev/null || \
            fail "$mh_path names $mh, which is not a commit of this repository"
    done
fi

snap=$(mktemp -d "${TMPDIR:-/tmp}/opf-pre-commit.XXXXXX") || fail "could not create a temporary directory"
# A removal that fails, or leaves the directory in place, exits 2 whatever the checks returned.
cleanup() {
    rm -rf -- "$snap" && [ ! -e "$snap" ] && [ ! -L "$snap" ] && return 0
    printf '%s\n' "opf-pre-commit: cannot evaluate: could not remove the snapshot directory $snap" >&2
    return 1
}
trap 'cleanup || exit 2' EXIT
trap 'exit 2' HUP INT TERM
: > "$snap/remotes" || fail "could not write the remote list"
for name in $remotes; do
    url=$(git remote get-url --push "$name") || fail "could not read the push URL of remote $name"
    printf '%s\n%s\n' "$name" "$url" >> "$snap/remotes" || fail "could not write the remote list"
done

# The snapshot is built with every GIT_ variable dropped, so the hook environment cannot rebind these
# commands to this repository, and with global and system configuration neutralized.
(
    for var in $git_vars; do
        unset "$var" || exit 2
    done
    GIT_CONFIG_GLOBAL=/dev/null
    GIT_CONFIG_NOSYSTEM=1
    export GIT_CONFIG_GLOBAL GIT_CONFIG_NOSYSTEM
    git -c init.defaultBranch=opf-snapshot init -q --template= "$snap/tree" || exit 2
    mkdir -p "$snap/tree/.git/objects/info" || exit 2
    printf '%s\n' "$objects" > "$snap/tree/.git/objects/info/alternates" || exit 2
    if [ -n "$head" ]; then
        git -C "$snap/tree" update-ref HEAD "$head" || exit 2
    fi
    if [ -n "$mh_lines" ]; then
        # The snapshot's own MERGE_HEAD (validated above; the ids resolve through the borrowed objects),
        # written one id per line as git writes it, so the doctor sees the merge being concluded.
        printf '%s\n' $mh_lines > "$snap/tree/.git/MERGE_HEAD" || exit 2
    fi
    while IFS= read -r name && IFS= read -r url; do
        git -C "$snap/tree" config "remote.$name.url" "$url" || exit 2
    done < "$snap/remotes"
    git -C "$snap/tree" read-tree "$tree" || exit 2
    git -C "$snap/tree" checkout-index -a -u -q || exit 2
) || fail "could not build the staged snapshot in $snap"

run_step doctor --require-store --root "$snap/tree" || exit $?
run_step render --check --root "$snap/tree"
exit $?
