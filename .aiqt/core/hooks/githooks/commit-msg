#!/usr/bin/env python3
"""commit-msg: refuse a commit whose message file holds the AI co-author trailer token (cmtidn).

The third layer of the commit-identity rule (integ/commit-identity). The PreToolUse hooks in
scripts/aiqt_hooks.py judge the assistant's own tool calls, so a commit made by ANY OTHER process (a
background script, a scheduler, a second agent, a human pasting a prepared message) never crosses them.
Installed as a git commit-msg hook, this script reads the one argument git passes (the path of the file
holding the proposed commit message, after templates, prepare-commit-msg, --trailer and the editor ran) and
exits non-zero when that file holds the token, so git refuses the commit itself, whoever drove it.

THE WHOLE MESSAGE FILE IS COUNTED: git runs this hook on its message buffer BEFORE its own cleanup, and
whether that cleanup drops comment lines, or the text from a scissors line on, is decided by options on
git's command line that a hook cannot see: --cleanup=<mode> overrides commit.cleanup (with verbatim,
whitespace or scissors git keeps a line starting with the comment string, so with core.commentChar set to
a letter a trailer line itself starts with it), and --verbose or --no-verbose overrides commit.verbose
(git drops the text from a scissors line on only under --verbose or commit.verbose, or under the scissors
cleanup when an editor ran, so --no-verbose beside a --cleanup other than scissors makes git keep that
text whatever commit.verbose and commit.cleanup say). So this hook drops
nothing: a comment line, whatever the comment string, and the text below a scissors line are counted, since
git may record them. The cost, disclosed: a commit whose comment lines or verbose diff hold the token is
refused even where git would drop them, such as a removal commit made with --verbose or with
commit.verbose set, whose diff below the scissors line shows the removed token line. Commit such a removal
without --verbose (git commit --no-verbose, or git -c commit.verbose=false commit) and without the token
in a comment line.

The token is TRAILER-SHAPED: the co-author trailer name, its words joined by a hyphen or one space in any
case, then optional blanks and a colon (git reads blanks before a trailer separator); prose that names the
words with no colon after them passes. The read is byte-based and decoded with surrogateescape, so any
ASCII-superset encoding is counted. The token is BUILT AT RUN TIME below and never spelled in this file,
so the pack's own file-content layer does not refuse edits to it.

Fail closed: a missing argument, an unreadable message file, or a file larger than the read bound refuses
the commit (exit 2 with the reason), never passes it. No removal carve-out exists here: the message file
must hold no occurrence at all (a trailer a human maintainer wants must be added outside this policy by
uninstalling the hook for that repository, a visible act).

DISCLOSED LIMITS: this layer works ONLY where it is installed (see the README beside this file). git runs
commit-msg for git commit and for a git merge that records a merge commit (with or without --no-edit); it
does NOT run for git commit --no-verify or git merge --no-verify, for plumbing such as git commit-tree, for
git notes or tags, for git am (which runs applypatch-msg instead), for git cherry-pick, git revert or git
rebase when they replay a message without an editor, or for forge-side edits (a PR body); those surfaces are
covered, best-effort, by the PreToolUse layers, and --no-verify inside the assistant's own calls by the
gate-weakening hook. A trailer spelled with a separator other than a colon (a trailer.separators setting
lets git parse one) is not counted.
"""
import sys

MAX_BYTES = 67_108_864  # past this bound the message cannot be scanned; refuse, never pass (fail closed)
TOKEN = "-".join(("Co", "Authored", "By"))  # built at run time, never spelled in this source


def main(argv):
    import re
    pattern = re.compile("(?i)" + "[- ]".join(("co", "authored", "by")) + "[ \t]*:")
    if len(argv) != 2:
        sys.stderr.write("commit-msg (aiqt cmtidn): expected exactly one argument, the message file path; "
                         "got {!r}. Refusing the commit (fail-closed).\n".format(argv[1:]))
        return 2
    try:
        with open(argv[1], "rb") as handle:
            data = handle.read(MAX_BYTES + 1)
    except OSError as exc:
        sys.stderr.write("commit-msg (aiqt cmtidn): cannot read the message file {!r} ({}). Refusing the "
                         "commit (fail-closed).\n".format(argv[1], exc))
        return 2
    if len(data) > MAX_BYTES:
        sys.stderr.write("commit-msg (aiqt cmtidn): the message file {!r} is larger than the {}-byte scan "
                         "bound. Refusing the commit (fail-closed).\n".format(argv[1], MAX_BYTES))
        return 2
    if pattern.search(data.decode("utf-8", "surrogateescape")):
        sys.stderr.write("commit-msg (aiqt cmtidn, commit-identity): the commit message file holds a '{}:' "
                         "trailer. A recorded change carries the human maintainer's own identity, with no AI "
                         "as author, committer, or co-author; remove the trailer from the message and commit "
                         "again. The whole file is counted, comment lines and any text below a scissors line "
                         "included, since a --cleanup or --[no-]verbose option this hook cannot see decides "
                         "whether git keeps them; a removal commit made with --verbose shows the removed line "
                         "there, so commit it without --verbose.\n".format(TOKEN))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
