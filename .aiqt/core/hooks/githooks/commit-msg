#!/usr/bin/env python3
"""commit-msg: refuse a commit whose message, as git will record it, holds the AI co-author trailer token (cmtidn).

The third layer of the commit-identity rule (integ/commit-identity). The PreToolUse hooks in
scripts/aiqt_hooks.py judge the assistant's own tool calls, so a commit made by ANY OTHER process (a
background script, a scheduler, a second agent, a human pasting a prepared message) never crosses them.
Installed as a git commit-msg hook, this script reads the one argument git passes (the path of the file
holding the proposed commit message, after templates and prepare-commit-msg ran) and exits non-zero when
the message git will record from it holds the token, so git refuses the commit itself, whoever drove it.

THE MESSAGE GIT WILL RECORD: git runs this hook on its message buffer BEFORE its own cleanup, so the hook
applies that cleanup first (recorded_message). When an editor ran (git sets GIT_EDITOR to ':' for the hook
when none does), everything from git's scissors line (the comment string, a space, then the cut line) on is
dropped, as git drops it under --verbose and the scissors cleanup, and, under git's default or strip
cleanup (the commit.cleanup setting), every line starting with the comment string (core.commentString,
else core.commentChar, else '#') is dropped. With no editor git's default cleanup keeps comment lines, so
they are counted. A legitimate removal commit (a staged diff that removes a token line, which --verbose
shows below the scissors line) therefore passes.

The token is TRAILER-SHAPED: the co-author trailer name, its words joined by a hyphen or one space in any
case, then optional blanks and a colon (git reads blanks before a trailer separator); prose that names the
words with no colon after them passes. The read is byte-based and decoded with surrogateescape, so any
ASCII-superset encoding is counted. The token is BUILT AT RUN TIME below and never spelled in this file,
so the pack's own file-content layer does not refuse edits to it.

Fail closed: a missing argument, an unreadable message file, or a file larger than the read bound refuses
the commit (exit 2 with the reason), never passes it; where git's configuration cannot be read (git cannot
be run), no cleanup is applied, so comment lines and a verbose diff are counted (a refusal, never a pass).
No removal carve-out exists here: the recorded message must hold no occurrence at all (a trailer a human
maintainer wants must be added outside this policy by uninstalling the hook for that repository, a visible
act).

DISCLOSED LIMITS: this layer works ONLY where it is installed (see the README beside this file). git runs
commit-msg for git commit and for a git merge that records a merge commit (with or without --no-edit); it
does NOT run for git commit --no-verify or git merge --no-verify, for plumbing such as git commit-tree, for
git notes or tags, for git am (which runs applypatch-msg instead), for git cherry-pick or git rebase when
they replay a message without an editor, or for forge-side edits (a PR body); those surfaces are covered,
best-effort, by the PreToolUse layers, and --no-verify inside the assistant's own calls by the
gate-weakening hook. The cleanup applied here is read from git's configuration and GIT_EDITOR; a --cleanup
option on the command line is not visible to a hook, so with an editor and --cleanup=verbatim or
--cleanup=whitespace a comment line holding the token is recorded but not counted (git does not parse a
line starting with the comment string as a trailer; how a forge reads one is unverified), and so is text
after a scissors line typed into such a message without --verbose. With core.commentChar set to auto no
comment line is dropped and no scissors line is found, which refuses such a removal commit, never passes it.
"""
import os
import subprocess
import sys

MAX_BYTES = 67_108_864  # past this bound the message cannot be scanned; refuse, never pass (fail closed)
TOKEN = "-".join(("Co", "Authored", "By"))  # built at run time, never spelled in this source
CUT_LINE = "-" * 24 + " >8 " + "-" * 24  # git's scissors line, after the comment string and a space


def git_config(key):
    """The value git reads for key here: '' when it is unset, None when git cannot be run or read it."""
    try:
        proc = subprocess.run(["git", "config", "--get", key], stdin=subprocess.DEVNULL,
                              capture_output=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return None
    if proc.returncode == 1 and not proc.stdout:
        return ""
    if proc.returncode != 0:
        return None
    return proc.stdout.decode("utf-8", "surrogateescape").rstrip("\n")


def recorded_message(text):
    """text with git's cleanup applied as far as a hook can see it (the module docstring): unchanged when no
    editor ran or when the comment string or the cleanup mode cannot be read."""
    if os.environ.get("GIT_EDITOR") == ":":
        return text
    comment = git_config("core.commentString")
    if comment == "":
        comment = git_config("core.commentChar")
    if comment == "":
        comment = "#"
    cleanup = git_config("commit.cleanup")
    if comment is None or cleanup is None or comment.lower() == "auto":
        return text
    cut = comment + " " + CUT_LINE + "\n"
    if text.startswith(cut):
        text = ""
    elif "\n" + cut in text:
        text = text[:text.index("\n" + cut) + 1]
    if cleanup.lower() in ("", "default", "strip"):
        text = "\n".join(line for line in text.split("\n") if not line.startswith(comment))
    return text


def main(argv):
    import re
    pattern = re.compile("(?i)" + "[- ]".join(("co", "authored", "by")) + "[ \t]*:")
    if len(argv) != 2:
        sys.stderr.write("commit-msg (aiqt cmtidn): expected exactly one argument, the message file path; "
                         "got {!r}. Refusing the commit (fail-closed).\n".format(argv[1:]))
        return 2
    try:
        with open(argv[1], "rb") as handle:
            data = handle.read(MAX_BYTES + 1)
    except OSError as exc:
        sys.stderr.write("commit-msg (aiqt cmtidn): cannot read the message file {!r} ({}). Refusing the "
                         "commit (fail-closed).\n".format(argv[1], exc))
        return 2
    if len(data) > MAX_BYTES:
        sys.stderr.write("commit-msg (aiqt cmtidn): the message file {!r} is larger than the {}-byte scan "
                         "bound. Refusing the commit (fail-closed).\n".format(argv[1], MAX_BYTES))
        return 2
    if pattern.search(recorded_message(data.decode("utf-8", "surrogateescape"))):
        sys.stderr.write("commit-msg (aiqt cmtidn, commit-identity): the commit message, as git will record "
                         "it, holds a '{}:' trailer. A recorded change carries the human maintainer's own "
                         "identity, with no AI as author, committer, or co-author; remove the trailer from "
                         "the message and commit again.\n".format(TOKEN))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
